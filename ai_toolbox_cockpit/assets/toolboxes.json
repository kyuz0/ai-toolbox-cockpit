    {
      "id": "strix-halo-llama-rocm-10-0-qwen-3-8-flash-next",
      "backend": "llama_cpp",
      "name": "llama-rocm-10.0-qwen-3.8-flash-next",
      "container_name": "llama-rocm-10.0-qwen-3.8-flash-next",
      "group": "Dev/Experimental Toolboxes",
      "image": "docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-10.0-qwen-3.8-flash-next",
      "channel": "experimental",
      "maturity": "experimental",
      "description": "Purpose-built Qwen3.8 Flash Next fork with GPU TOP_K, native MTP, and ngram-mod (Strix Halo only)",
      "runtime_profile": "amd-rocm",
      "supports_load_mode": true,
      "features": {
        "interactive": "experimental",
        "server": "experimental",
        "models": "experimental"
      },
      "backend_config": {
        "recommended_use": {
          "platform_id": "strix-halo",
          "model_id": "llama-unsloth-qwen3-8-flash-next-gguf",
          "model_filename_pattern": "*UD-IQ4_XS*.gguf",
          "model_display_name": "Qwen 3.8 Flash Next UD-IQ4_XS",
          "message": "Validated for Qwen 3.8 Flash Next UD-IQ4_XS on AMD Strix Halo / gfx1151 with drluoto's Q8_0 MTP sidecar.",
          "documentation_url": "https://github.com/drluoto/flash-next-strix-halo",
          "sidecar": {
            "repo": "drluoto/Qwen3.8-Flash-Next-MTP-GGUF",
            "filename": "mtp-Qwen3.8-Flash-Next-Q8_0.gguf"
          },
          "server_defaults": {
            "context_size": 262144,
            "gpu_layers": 999,
            "parallel_sequences": 1,
            "load_mode": "dio",
            "flash_attention": true,
            "mtp": {
              "default_draft_n": 3,
              "default_np": 1,
              "spec_types": [
                "draft-mtp",
                "ngram-mod"
              ],
              "ngram_mod_n_max": 64,
              "ngram_mod_n_match": 24
            }
          }
        }
      }
    },
    {
      "id": "strix-halo-llama-rocm-10-0-engramhalo",
      "backend": "llama_cpp",
      "name": "llama-rocm-10.0-engramhalo",
      "container_name": "llama-rocm-10.0-engramhalo",
      "group": "Dev/Experimental Toolboxes",
      "image": "docker.io/kyuz0/amd-strix-halo-toolboxes:rocm-10.0-engramhalo",
      "channel": "experimental",
      "maturity": "experimental",
      "description": "EngramHalo Qwen3.8 Flash-Next ROCm/HIP fork with sparse QSA, SSD-backed engram loading, and MTP (Strix Halo only; experimental ROCm 10.0 port)",
      "runtime_profile": "amd-rocm-hipblaslt",
      "supports_load_mode": true,
      "features": {
        "interactive": "experimental",
        "server": "experimental",
        "models": "experimental"
      },
      "backend_config": {
        "recommended_use": {
          "platform_id": "strix-halo",
          "model_id": "llama-unsloth-qwen3-8-flash-next-gguf",
          "model_filename_patterns": [
            "*UD-IQ3_XXS*.gguf",
            "*UD-IQ4_XS*.gguf"
          ],
          "model_display_name": "Qwen 3.8 Flash Next UD-IQ3_XXS or UD-IQ4_XS",
          "message": "EngramHalo SSD + MTP profile for Qwen 3.8 Flash Next on AMD Strix Halo / gfx1151.",
          "documentation_url": "https://github.com/Aristo94/EngramHalo.cpp/blob/strix-halo-qwen4exp/docs/strix-halo/README.md",
          "notes": [
            "Validated main-model quants: UD-IQ3_XXS and UD-IQ4_XS.",
            "SSD default: mmap with --lazy-mode on keeps the 26.8 GiB engram table SSD-backed, with about 1–1.5 GiB resident.",
            "RAM option: select load mode none and replace --lazy-mode on with --lazy-mode off; budget another 26.8 GiB of RAM.",
            "MTP is validated at 163840 context with one slot. Disable MTP for 262144 context or multiple parallel slots."
          ],
          "sidecar": {
            "repo": "EasiiX/Qwen3.8-Flash-Next-MTP-Strix-Halo-GGUF",
            "filename": "mtp-Qwen3.8-Flash-Next-Q8_0.gguf"
          },
          "server_defaults": {
            "context_size": 163840,
            "batch_size": 8192,
            "ubatch_size": 2048,
            "gpu_layers": 999,
            "parallel_sequences": 1,
            "kv_cache_type": "q8_0",
            "load_mode": "mmap",
            "flash_attention": true,
            "extra_args": "--lazy-mode on -t 4",
            "mtp": {
              "default_draft_n": 4,
              "default_np": 1,
              "spec_types": [
                "draft-mtp",
                "ngram-mod"
              ],
              "spec_draft_p_min": 0.75
            }
          }
        }
      }
    },
