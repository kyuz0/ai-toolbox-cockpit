{
  "schema_version": 3,
  "runtime_profiles": {
    "amd-rocm": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--device",
        "/dev/kfd",
        "--group-add",
        "video",
        "--group-add",
        "render",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
    "amd-rocm-hipblaslt": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--device",
        "/dev/kfd",
        "--group-add",
        "video",
        "--group-add",
        "render",
        "--security-opt",
        "seccomp=unconfined",
        "--env",
        "ROCBLAS_USE_HIPBLASLT=1"
      ]
    },
    "amd-rocm-keep-groups": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--device",
        "/dev/kfd",
        "--group-add",
        "keep-groups",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
    "vulkan": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--group-add",
        "video",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
    "intel-level-zero": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--group-add",
        "video",
        "--group-add",
        "render",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
    "nvidia-gb10": {
      "engine_args": [
        "--runtime",
        "/usr/bin/nvidia-container-runtime",
        "--env",
        "NVIDIA_VISIBLE_DEVICES=nvidia.com/gpu=all"
      ]
    },
    "halogen-strix-halo": {
      "engine_args": [
        "--device",
        "/dev/kfd",
        "--device",
        "/dev/dri",
        "--group-add",
        "video",
        "--group-add",
        "render",
        "--security-opt",
        "seccomp=unconfined",
        "--ipc=host",
        "--ulimit",
        "memlock=-1:-1"
      ]
    }
  },
