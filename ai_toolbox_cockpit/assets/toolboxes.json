{
  "schema_version": 3,
  "runtime_profiles": {
    "amd-rocm": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--device",
        "/dev/kfd",
        "--group-add",
        "video",
        "--group-add",
        "render",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
    "amd-rocm-keep-groups": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--device",
        "/dev/kfd",
        "--group-add",
        "keep-groups",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
    "vulkan": {
      "engine_args": [
        "--device",
        "/dev/dri",
        "--group-add",
        "video",
        "--security-opt",
        "seccomp=unconfined"
      ]
    },
